# ============================================
# Solami Sentinel — Environment Variables
# ============================================
# Copy this file to `.env` and fill in your keys.
# Never commit `.env` to the repo.

# ----- Solami (https://solami.dev/signup?ref=st-earn-sep-26) -----
# Get your API key from the Solami dashboard.
# Required scopes: RPC (read) + DataApi + Streaming bandwidth.
VITE_SOLAMI_API_KEY=sk_your_key_here
VITE_SOLAMI_RPC_URL=https://rpc.solami.dev/sol
VITE_SOLAMI_WS_URL=wss://ws.solami.dev/ws/sol

# ----- Helius (https://dashboard.helius.dev) -----
# Free-tier RPC used as fallback for RPC + WebSocket.
# Grab the UUID-only key and paste it in both URLs below.
VITE_HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key_here
VITE_HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=your_helius_key_here

# ----- Runtime -----
# Set to `true` to force mock mode (no external APIs hit).
# Useful for UI development or when APIs are down.
VITE_USE_MOCK=false